{
  "name": "kaoyan-english-one",
  "private": true,
  "version": "1.1.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder --win",
    "android:sync": "vite build && npx cap sync android",
    "android:apk": "cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "com.kaoyan.english",
    "productName": "考研英语真题题库",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.7",
    "vite-plugin-pwa": "^0.20.5"
  }
}
